{
    "bid": "XXT-Device-GUI-Agent",
    "buildIgnores": [
        "/lua/scripts/main.json",
        "/lua/scripts/XXTLanControl.lua",
        "/lua/XXTLanControl.lua",
        "/XXTLanControl.lua"
    ],
    "entitlements": {
        "allow-external-require": false
    },
    "ignores": [
        "/.dist",
        "/.git",
        "/xxtouch-script-guide.md",
        "/AGENTS.md",
        "/CLAUDE.md",
        "/GEMINI.md",
        ".dist",
        "/.agents"
    ],
    "information": [
        [
            "Description",
            "使用 XXTouch 脚本实现的基于外部视觉模型设备日常界面操作 Agent"
        ],
        [
            "Version",
            "0.0.1"
        ]
    ],
    "libs": [],
    "name": "",
    "onEncryptSuccess": {
        "darwin": "echo ${fileDirname}",
        "default": "echo ${file}, ${fileDirname}, ${fileBasename}",
        "win32": "echo ${fileDirname}"
    },
    "type": "xxt",
    "vscode": {
        "pickerStudio": {
            "storageMode": "globalState"
        }
    }
}
